#!/usr/bin/env bash

_usage() {
    printf '%s\n' "usage: git get [--nested] <url>
usage: git get --help

Clone a repository in a particular directory.

With --nested, the repository is cloned under
'<clone-path>/<host>/<owner>/<repo>' using the URL structure."
}

if (( $# == 0 )); then
    _usage
    exit 0
fi

for arg; do
    if [ "$arg" = '-h' ] || [ "$arg" = '--help' ]; then
        _usage
        exit 0
    fi
done

nested=0
args=()
for arg; do
    if [ "$arg" = '--nested' ]; then
        nested=1
    else
        args+=("$arg")
    fi
done

if (( ${#args[@]} == 0 )); then
    _usage
    exit 1
fi

url=${args[0]}
args=("${args[@]:1}")

clone_path=$(git config --get git-extras.get.clone-path)

if [ -z "$clone_path" ]; then
    printf 'ERROR: %s\n' "Git configuration key 'git-extras.get.clone-path' must be set to a directory to clone under" >&2
    exit 1
fi

parse_repo_url() {
    local url="$1"
    url=${url%/}
    if [[ "$url" =~ ^https?://([^/]+)/(.+)$ ]]; then
        local host="${BASH_REMATCH[1]}"
        host="${host##*@}" # strip userinfo
        host="${host%%:*}" # strip port
        printf '%s/%s\n' "$host" "${BASH_REMATCH[2]%.git}"
    elif [[ "$url" =~ ^git@([^:]+):(.+)$ ]]; then
        printf '%s/%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]%.git}"
    else
        return 1
    fi
}

if (( nested )); then
    if ! dirname=$(parse_repo_url "$url"); then
        printf 'ERROR: %s\n' "Could not parse repository URL: $url" >&2
        printf '%s\n' "Supported formats:" >&2
        printf '%s\n' "  - https://github.com/owner/repo" >&2
        printf '%s\n' "  - git@github.com:owner/repo" >&2
        exit 1
    fi
else
    dirname=${url%/}
    dirname=${dirname%.git}
    dirname=${dirname##*/}
fi

mkdir -p "$(dirname "$clone_path/$dirname")"
git clone "$url" "$clone_path/$dirname" "${args[@]}"
