#!/usr/bin/env bash

gitignore_templates_url="https://api.github.com/repos/github/gitignore/git/trees/main?recursive=1"
gitignore_io_url="https://raw.githubusercontent.com/github/gitignore/main/"
default_path="$HOME/.gi_list"
if [[ -n "$XDG_CACHE_HOME" ]]; then
  default_path="$XDG_CACHE_HOME/git-extras/gi_list"
  mkdir -p "$XDG_CACHE_HOME/git-extras"
fi

update_gi_list() {
    local response tmp templates

    if ! response=$(curl -fsSL "$gitignore_templates_url"); then
        echo "Unable to update gitignore template list" >&2
        return 1
    fi
    templates=$(printf '%s\n' "$response" |
        sed -n 's/.*"path": "\([^"]*\.gitignore\)".*/\1/p' |
        sed 's/\.gitignore$//' | sort -u)
    if [[ -z "$templates" ]]; then
        echo "Unable to update gitignore template list: no templates found" >&2
        return 1
    fi
    mkdir -p "$(dirname "$default_path")"
    tmp=$(mktemp "${default_path}.tmp.XXXXXX") || return 1
    printf '%s\n' "$templates" > "$tmp"
    mv "$tmp" "$default_path"
}


print_in_alphabetical_order() {
    local first_character previous_first_character ignorable
    local first=true
    for ignorable in $(echo "$gi_list" | sort);
    do
        first_character=${ignorable:0:1}
        if [[ $first_character = "$previous_first_character" ]]; then
            printf " %s" "$ignorable"
        elif [[ $first = true ]]; then
            previous_first_character=$first_character
            first=false
            printf "%s" "$ignorable"
        else
            previous_first_character=$first_character
            printf "\n%s" "$ignorable"
        fi
    done
    echo
}

print_in_table_format() {
    echo "$gi_list" | column
}

search() {
    for type in $gi_list;
    do
        if [[ "$type" == *$1* ]]
        then
            echo "$type"
        fi
    done
}

print_last_modified_time() {
    if ! gi_list_date=$(stat -c "%y" "$default_path" 2> /dev/null); then
        if ! gi_list_date=$(stat -f "%t%Sm" "$default_path" 2> /dev/null); then
            if ! gi_list_date=$(date -r "$default_path" +%s 2> /dev/null); then
                gi_list_date=0
            fi
        fi
    fi
    echo "Last update time: $gi_list_date"
}

gi() {
    local type template failed=0
    local types
    types=$(printf '%s' "$1" | tr ',' ' ')
    for type in $types; do
        template=$(printf '%s\n' "$gi_list" |
            awk -v type="$type" '
                {
                    name=$0
                    short=name
                    sub(/^.*\//, "", short)
                    if (tolower(name) == tolower(type) || tolower(short) == tolower(type)) {
                        print name
                        exit
                    }
                }')
        if [[ -z "$template" ]]; then
            echo "Template not found: $type" >&2
            failed=1
            continue
        fi
        if ! curl -fsSL "$gitignore_io_url${template}.gitignore"; then
            echo "Unable to fetch template: $type" >&2
            failed=1
        else
            printf '\n'
        fi
    done
    return "$failed"
}

gi_replace() {
    local tmp
    tmp=$(mktemp .gitignore.tmp.XXXXXX) || return 1
    trap 'rm -f "$tmp"' EXIT INT TERM
    if ! gi "$1" > "$tmp"; then
        rm -f "$tmp"
        trap - EXIT INT TERM
        return 1
    fi
    mv "$tmp" .gitignore
    trap - EXIT INT TERM
}

gi_append() {
    local tmp ret=0
    tmp=$(mktemp .gitignore.tmp.XXXXXX) || return 1
    trap 'rm -f "$tmp"' EXIT INT TERM
    if ! gi "$1" > "$tmp"; then
        rm -f "$tmp"
        trap - EXIT INT TERM
        return 1
    fi
    cat "$tmp" >> .gitignore || ret=1
    rm -f "$tmp"
    trap - EXIT INT TERM
    return "$ret"
}

show_usage() {
    echo "Usage:"
    echo "  git ignore-io <types>...                    Show gitignore template"
    echo "                [-a|--append] <types>...      Append new .gitignore content to .gitignore under the current directory"
    echo "                [-r|--replace] <types>...      Export new .gitignore to the current directory (The old one will be replaced)"
    echo "                [-l|--list-in-table]          Print available types in table format"
    echo "                [-L|--list-alphabetically]    Print available types in alphabetical order    "
    echo "                [-s|--search] <word>          Search word in available types"
    echo "                [-t|--show-update-time]       Show the last modified time of $default_path (where the list of available types is stored)"
    echo "                [-u|--update-list]            Update $default_path"
}

check_list_exist() {
    if [[ ! -f "$default_path" ]]; then
        echo "-----Initial GitHub gitignore template list----"
        if ! update_gi_list; then
            return 1
        fi
        echo "-----Save to $default_path-----"
        echo
    fi
    gi_list=$(tr "," "\n" < "$default_path" 2>/dev/null)
}

check_list_exist || exit $?
if [[ $# -eq 0 ]]; then
    show_usage
else
    case $1 in
        -a|--append|-r|--replace)
            opt=$1
            shift
            if [[ $# -eq 0 ]]; then
                echo "There should be at least one type"
                echo
                show_usage
                exit
            fi

            gi_to_curl=$(echo "$@" | tr " " ",")
            case $opt in
            -a|--append)
                gi_append "$gi_to_curl"
                ;;
            -r|--replace)
                gi_replace "$gi_to_curl"
                ;;
            esac

            exit
            ;;
        -t|--show-update-time)
            print_last_modified_time
            ;;
        -u|--update-list)
            update_gi_list
            ;;
        -s|--search)
            opt=$1
            shift
            if [[ $# -eq 0 ]]; then
                show_usage
                exit
            fi
            search "$1"
            ;;
        -L|--list-alphabetically)
            print_in_alphabetical_order
            ;;
        -l|--list-in-table)
            print_in_table_format
            ;;
        -*)
            echo No Such option
            show_usage
            ;;
        *)
            gi_to_curl=$(echo "$@" | tr " " ",")
            gi "$gi_to_curl"
            ;;
    esac
fi
